# =============================================================================
# Nagarik Palika backend — copy to backend/.env
# =============================================================================

# MongoDB
USE_MEMORY_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/nagarik-palika

# JWT for admin, citizen, advocate, and Sajilo Kanun sessions
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Seeded superadmin account (upserted on each backend start)
SUPERADMIN_EMAIL=admin@nagarikpalika.gov.np
SUPERADMIN_PASSWORD=ChangeMe@123
# Legacy aliases (optional; SUPERADMIN_* takes precedence)
ADMIN_EMAIL=admin@nagarikpalika.gov.np
ADMIN_PASSWORD=ChangeMe@123

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Google OAuth (citizen & advocate sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# eSewa payment (UAT)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_VERIFY_URL=https://uat.esewa.com.np/api/epay/transaction/status/

# Khalti payment (test)
KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd57cb46c19d64e33b256af0
KHALTI_SECRET_KEY=test_secret_key

# Skip real payment in development
ALLOW_DEV_PAYMENT=true

# Cron: POST /internal/consultations/open-pool
# Also used as x-internal-secret for Gemini key runtime pool (Next.js → API)
CRON_SECRET=dev-cron-secret
# Optional override for Gemini key pool internal auth
# INTERNAL_API_SECRET=
# Optional dedicated secret for encrypting Gemini keys at rest (defaults to JWT_SECRET)
# GEMINI_KEY_ENCRYPTION_SECRET=
# Optional: seed Gemini key pool when Mongo is empty
# GEMINI_API_KEY=
# GEMINI_API_KEY_FALLBACK=

# Sajilo Kanun demo login (seeded when no accounts exist)
SAJILOKANUN_DEMO_USERNAME=demo
SAJILOKANUN_DEMO_PASSWORD=Demo@123
SAJILOKANUN_DEMO_EMAIL=demo@nagarikpalika.gov.np

# Cloudflare R2 — case document storage (firm/case isolated keys)
# Object key: firms/{teamId}/cases/{caseId}/{uuid}-{fileName}
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sajilokanun-case-files
# Optional override (defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=

# Glossary JSON override (default: ./data)
# DATA_DIR=./data
